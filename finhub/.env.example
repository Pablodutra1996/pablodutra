# ====== Básico ======
# Seu e-mail: em site público, só ele pode criar a conta de administrador no primeiro acesso
ADMIN_EMAIL=
PORT=3000
NODE_ENV=production
# URL pública da plataforma (usada nos links dos e-mails e no login Microsoft). Use HTTPS em produção.
APP_URL=https://finhub.suaempresa.com.br
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
DATA_DIR=./data

# ====== Banco de dados ======
# Vazio = SQLite em arquivo (DATA_DIR/finhub.db). Preencha para usar PostgreSQL (Supabase, Neon, Render, Azure...)
# Supabase: Connect > Session pooler > URI (com a senha no lugar de [YOUR-PASSWORD])
DATABASE_URL=
TZ_NAME=America/Sao_Paulo
TZ_OFFSET=-03:00
MAX_UPLOAD_MB=25

# ====== E-mail ======
# Opção 1 (recomendada em hospedagem gratuita): API do Brevo — grátis, sem cartão, não usa portas SMTP
BREVO_API_KEY=
# Opção 2: SMTP
# Sem SMTP_HOST os e-mails são gravados em DATA_DIR/outbox (modo teste).
# Microsoft 365: smtp.office365.com / 587 (exige "SMTP AUTH" habilitado na caixa) — ou use SendGrid, Amazon SES, Brevo...
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=financeiro@suaempresa.com.br
SMTP_PASS=
MAIL_FROM="FinHub Financeiro <financeiro@suaempresa.com.br>"

# ====== Armazenamento de arquivos (evidências, anexos, backups) ======
# local | azure | s3
STORAGE_DRIVER=azure
# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=finhub
# AWS S3 ou compatível (Cloudflare R2, Backblaze B2, Wasabi, MinIO)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Backup diário (02:00) do banco para o storage. Padrão: ligado quando STORAGE_DRIVER != local
BACKUP_ENABLED=true

# ====== Microsoft To Do (Microsoft Graph) ======
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" aceita qualquer conta; use o ID do seu tenant para restringir à empresa
MS_TENANT_ID=common

# ====== Rotinas automáticas (fuso TZ_NAME; verificadas a cada 15 min) ======
# Lembretes em dias úteis, entre estas horas. Cada tarefa atrasada é lembrada a cada OVERDUE_REMINDER_HOURS até ser concluída.
REMINDER_START_HOUR=8
REMINDER_END_HOUR=18
OVERDUE_REMINDER_HOURS=24
DUE_SOON_HOURS=24
# Relatório mensal: dia 1, a partir desta hora (referente ao mês anterior)
MONTHLY_REPORT_HOUR=8

# ====== Videochamada ======
# STUN público já incluído. Para redes corporativas restritas, configure um TURN (ex.: coturn, Twilio, Cloudflare Calls)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
